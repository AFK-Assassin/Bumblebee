# ── Bumblebee AI — Backend Environment Variables ──────────────────────
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/bumblebee_db

# Ollama (Local AI Models)
OLLAMA_HOST=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
GEN_MODEL=llama3.2:3b

# Optional: use a system prompt to give Bumblebee a personality
SYSTEM_PROMPT=You are Bumblebee, a friendly and intelligent AI assistant. Answer clearly and helpfully.
